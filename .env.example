# Copy this file to .env and fill in real values.
#   cp .env.example .env
#
# .env is gitignored. Do not commit secrets.

# development | test | production
APP_ENV=development

# true | false
APP_DEBUG=true

# debug | info | warning | error
LOG_LEVEL=info

# Replace in production with a long random string.
SECRET_KEY=change-me

# SQLite file. Relative paths are resolved from the project root.
DATABASE_PATH=data/agora.db

# Local disk for project/task attachments (gitignored).
UPLOAD_DIR=uploads

# Upload limits (bytes) and comma-separated extensions (no dots).
MAX_UPLOAD_BYTES=10485760
ALLOWED_UPLOAD_EXTENSIONS=pdf,png,jpg,jpeg,gif,webp,txt,md,csv,docx,xlsx,zip

# Used only to create invite-only seed/invite accounts. Change after first login.
# Never put a real production password here.
SEED_DEFAULT_PASSWORD=ChangeMe!OfficeAgora

# Web server for `make run` / `python -m agora`
HOST=127.0.0.1
PORT=8000

# A user is "online" if a heartbeat arrived within this many seconds.
PRESENCE_TIMEOUT_SECONDS=45

SESSION_COOKIE_NAME=agora_session

# Leave empty locally. Set to /office behind Apache at dogscout.be/office
ROOT_PATH=

# SpaceXAI / xAI — optional. Without a key, Grok still posts heuristic briefings.
# Get a key at https://console.x.ai — never commit the real value.
XAI_API_KEY=
XAI_MODEL=grok-4.6
